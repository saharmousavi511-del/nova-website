{
  "name": "nova-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "وب‌سایت رسمی گروه مشاوره کنکور نووا (NOVA) — مشاوره، برنامه‌ریزی، فرم ثبت‌نام و آزمون آنلاین",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:logic": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --tsconfig=tsconfig.json --log-level=warning && node node_modules/.cache/smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vazirmatn": "^33.0.3",
    "vite": "^6.4.3"
  }
}
